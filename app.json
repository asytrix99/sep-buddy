{
  "expo": {
    "name": "ryd-map",
    "slug": "ryd-map",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.asytrix99.sepbuddy",
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "infoPlist": {
        "CFBundleDisplayName": "Sep Buddy"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "rydmap",
    "plugins": [
      "./plugins/withoutPushEntitlement",
      "./plugins/withoutScriptSandboxing",
      "expo-router",
      [
        "expo-notifications",
        {}
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow the app to lock your cycle data with Face ID."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shows where you are on the map and finds food nearby."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-background-task",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#e8f4fd",
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e369797a-bc0c-4a5b-a4d9-5600d935b34d"
      }
    },
    "owner": "asytrix",
    "updates": {
      "url": "https://u.expo.dev/e369797a-bc0c-4a5b-a4d9-5600d935b34d",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
